DJANGO_SECRET_KEY=replace_me_with_strong_secret_without_unescaped_dollar
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,SERVERARH,91.224.86.10,227info.online
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://SERVERARH:8001,http://91.224.86.10:9090,https://227info.online
USE_HTTPS=False
# Публичный домен CRM. A-запись @ -> IP VPS, затем: docker compose --profile https up -d
CRM_DOMAIN=227info.online
# Локально 8001. Облако Cloud.ru — 9090 (порт уже открыт в группе безопасности).
CRM_HTTP_PORT=8001
# Кабинет заказчика: ID + пароль, без почты и OTP (ограничения Роскомнадзора). SMTP для клиентов не нужен.

POSTGRES_DB=chcrm
POSTGRES_USER=chcrm_user
POSTGRES_PASSWORD=chcrm_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Владелец системы: логин учётки с ролью superadmin (не роль admin).
PLATFORM_OWNER_USERNAME=superadmin

# Умник (поиск и чат). CRM ходит ТОЛЬКО в облачный query-умник на хосте VPS, не в офисный индексатор.
# Прод и локальный Docker: http://host.docker.internal:7861 (умник слушает на хосте, не в контейнере).
UMNIK_URL=http://host.docker.internal:7861
UMNIK_TOKEN=
UMNIK_TIMEOUT=3
UMNIK_CHAT_TIMEOUT=180
# Базовый URL CRM для умника — чтобы качать вложения чата
# Прод: публичный HTTPS CRM. Локально: LAN-адрес Docker-хоста.
UMNIK_CRM_BASE_URL=http://192.168.1.10:8000
# Файлы <= этого размера уходят умнику прямо в запросе (base64), крупнее — по ссылке
UMNIK_CHAT_INLINE_MAX_MB=15
# Вариант B: та же папка вложений чата глазами машины умника (UNC или сетевой диск).
# На этом же компьютере оставить как есть. На другом — напр. \\SERVER\CH-CRM\crm_files
UMNIK_SHARED_ROOT=D:\CH-CRM\crm_files
# Общий чат: лимит на вложение и точки монтирования источников «с сервера»
UMNIK_CHAT_MAX_UPLOAD_MB=40
UMNIK_SRC_RABOCHAYA=/mnt/rabochaya
UMNIK_SRC_SCAN=/mnt/scan_pdf

# Телеграм-бот диспетчерской. Токен у @BotFather, ID группы — у бота (getUpdates)
# или @RawDataBot. Держать ТОЛЬКО здесь, в git не коммитить. Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DISPATCH_CHAT_ID=0
TELEGRAM_PROXY=
TELEGRAM_POLL_TIMEOUT=50
TELEGRAM_MAX_FILE_MB=45

# Расшифровка голосовых из телеграма (speech-to-text).
# BACKEND=local — faster-whisper в контейнере, бесплатно, без ключей и прокси (по умолчанию).
#   Модель качается один раз с HuggingFace в volume whisper_cache.
#   LOCAL_MODEL: base (быстро), small (баланс, ок для русского), medium (точнее, тяжелее).
# BACKEND=api — OpenAI-совместимый эндпоинт /audio/transcriptions (тогда задать URL/KEY/MODEL):
#   OpenAI:  https://api.openai.com/v1/audio/transcriptions  + whisper-1
#   Groq:    https://api.groq.com/openai/v1/audio/transcriptions + whisper-large-v3
#   whisper.cpp: http://host.docker.internal:PORT/v1/audio/transcriptions
SPEECH_TO_TEXT_BACKEND=local
SPEECH_TO_TEXT_LOCAL_MODEL=small
SPEECH_TO_TEXT_DEVICE=cpu
SPEECH_TO_TEXT_COMPUTE=int8
SPEECH_TO_TEXT_LANGUAGE=ru
SPEECH_TO_TEXT_MAX_MB=25
SPEECH_TO_TEXT_URL=
SPEECH_TO_TEXT_KEY=
SPEECH_TO_TEXT_MODEL=whisper-1
SPEECH_TO_TEXT_TIMEOUT=120
# Пусто — для скачивания модели берётся TELEGRAM_PROXY / HTTPS_PROXY
SPEECH_TO_TEXT_PROXY=
