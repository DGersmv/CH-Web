DJANGO_SECRET_KEY=replace_me_with_strong_secret_without_unescaped_dollar
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,SERVERARH
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://SERVERARH:8001
USE_HTTPS=False

POSTGRES_DB=chcrm
POSTGRES_USER=chcrm_user
POSTGRES_PASSWORD=chcrm_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Умник (архив PDF). Процесс: umnik/mcp_server.py --http. Из Docker на этот же компьютер: host.docker.internal
UMNIK_URL=http://host.docker.internal:7861
UMNIK_TOKEN=
UMNIK_TIMEOUT=3
UMNIK_CHAT_TIMEOUT=180
# Базовый URL CRM для умника (он на другой машине) — чтобы качать вложения чата
UMNIK_CRM_BASE_URL=http://192.168.1.10:8000
# Файлы <= этого размера уходят умнику прямо в запросе (base64), крупнее — по ссылке
UMNIK_CHAT_INLINE_MAX_MB=15
# Вариант B: та же папка вложений чата глазами машины умника (UNC или сетевой диск).
# На этом же компьютере оставить как есть. На другом — напр. \\SERVER\CH-CRM\crm_files
UMNIK_SHARED_ROOT=D:\CH-CRM\crm_files
# Общий чат: лимит на вложение и точки монтирования источников «с сервера»
UMNIK_CHAT_MAX_UPLOAD_MB=40
UMNIK_SRC_RABOCHAYA=/mnt/rabochaya
UMNIK_SRC_SCAN=/mnt/scan_pdf

# Телеграм-бот диспетчерской. Токен у @BotFather, ID группы — у бота (getUpdates)
# или @RawDataBot. Держать ТОЛЬКО здесь, в git не коммитить. Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DISPATCH_CHAT_ID=0
TELEGRAM_PROXY=
TELEGRAM_POLL_TIMEOUT=50
TELEGRAM_MAX_FILE_MB=45
