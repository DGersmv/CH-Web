# local — разработка на одной машине (как раньше).
# indexer — офисный ПК у D:\Общая_Рабочая: только индекс и выгрузка в S3.
# query — облачный умник на хосте VPS: забирает индекс, отвечает CRM, может править код.
UMNIK_ROLE=local
MCP_CRM_MODE=1
PLATFORM_OWNER_USERNAME=superadmin
CRM_ROOT=

ARCHIVE_ROOT=D:\Общая_Рабочая

# Снимок индекса. Cloud.ru Object Storage: endpoint https://s3.cloud.ru, регион ru-central-1.
# Access Key ID в Cloud.ru — это «ID тенанта:Key ID», не один Key ID.
INDEX_S3_BUCKET=ch-crm
INDEX_S3_PREFIX=umnik-index
INDEX_S3_ENDPOINT=https://s3.cloud.ru
INDEX_S3_REGION=ru-central-1
INDEX_S3_ACCESS_KEY=
INDEX_S3_SECRET_KEY=

# Без S3: общая папка/диск, куда indexer кладёт latest.tar.gz (для отладки).
INDEX_SNAPSHOT_DIR=

MCP_TOKEN=
MCP_PORT=7861
CRM_API_URL=http://127.0.0.1:8001
